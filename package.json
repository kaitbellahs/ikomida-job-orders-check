{
    "name": "ikomida-orders-check-job",
    "version": "1.0.6",
    "description": "ikomida orders-check job",
    "private": true,
    "module": "build/job.js",
    "types": "build/job.d.ts",
    "files": [
        "build"
    ],
    "type": "module",
    "scripts": {
        "job": "node build/job.js",
        "build": "rimraf ./build ./types ./docs && rollup -c",
        "prebuild:types": "rimraf ./types",
        "build:types": "tsc -p ./tsconfig.json --outDir build && api-extractor run",
        "predoc:jsdoc": "rimraf ./docs",
        "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
        "predoc:typedoc": "rimraf ./docs",
        "docs:typedoc": "typedoc src --out docs",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "eslint . --ext .ts --quiet --fix",
        "clean": "rimraf ./build ./types ./docs",
        "local": "yarn glogin && ncu -u && yarn && yarn format && yarn lint && yarn build",
        "glogin": "artifactregistry-auth"
    },
    "author": "Khalid Ait Bellahs",
    "license": "UNLICENSED",
    "dependencies": {
        "@ikomida/shared-backend": "^1.2.0"
    },
    "devDependencies": {
        "@firebase/app-types": "0.x",
        "@microsoft/api-extractor": "^7.33.4",
        "@rollup/plugin-json": "^5.0.0",
        "@rollup/plugin-node-resolve": "^15.0.0",
        "@rollup/plugin-typescript": "^9.0.1",
        "@types/amqplib": "^0.8.2",
        "@types/bcrypt": "^5.0.0",
        "@types/express": "^4.17.14",
        "@types/linkify-it": "^3.0.2",
        "@types/luxon": "^3.0.2",
        "@types/node": "^18.11.2",
        "@types/node-mailjet": "^3.3.9",
        "@types/sequelize": "^4.28.14",
        "@types/sharp": "^0.31.0",
        "@types/uuid": "^8.3.4",
        "@types/validator": "^13.7.8",
        "@typescript-eslint/eslint-plugin": "^5.40.1",
        "@typescript-eslint/parser": "^5.40.1",
        "chai": "^4.3.6",
        "eslint": "^8.25.0",
        "eslint-config-prettier": "^8.5.0",
        "google-artifactregistry-auth": "^3.0.2",
        "jsdoc": "^3.6.11",
        "linkify-it": "^4.0.1",
        "mocha": "^10.1.0",
        "prettier": "^2.7.1",
        "rimraf": "^3.0.2",
        "rollup": "^3.2.3",
        "rollup-plugin-auto-external": "^2.0.0",
        "rollup-plugin-terser": "^7.0.2",
        "tslib": "^2.4.0",
        "typedoc": "^0.23.17",
        "typescript": "^4.8.4"
    }
}